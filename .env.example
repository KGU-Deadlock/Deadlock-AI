# ── Application ───────────────────────────────────────────────
APP_NAME="Deadlock AI"
APP_VERSION="0.1.0"
DEBUG=true

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
WHISPER_MODEL=whisper-1
INTERVIEW_MODEL=gpt-4o-mini

# ── File Upload ───────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=26214400

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
